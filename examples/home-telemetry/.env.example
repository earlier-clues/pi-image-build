# home-telemetry example config. Copy to .env and fill in.
#
#     cp examples/home-telemetry/.env.example examples/home-telemetry/.env
#
# Then build with:
#
#     bin/build-image.sh examples/home-telemetry --output-format gz

# =========================================================================
# core (baseline OS) — required
# =========================================================================

HOSTNAME=home-telemetry
TIMEZONE=America/Los_Angeles
PI_USER=pi

# Generate with:  openssl passwd -6 'your-password'
# Single-quote to keep $ literal.
ENCRYPTED_PASSWORD='$6$REPLACEME$REPLACEME'

# Paste the *contents* of your pubkey (e.g. ~/.ssh/id_ed25519.pub):
SSH_PUBKEY='ssh-ed25519 AAAA... you@host'

# Optional:
# KEYMAP=us
# AP_COUNTRY=US

# =========================================================================
# home-wifi (this payload's wifi-profile module) — required
# =========================================================================
#  >>> HOME WIFI CREDENTIALS GO HERE <<<

WIFI_SSID=YourHomeSSID
WIFI_PSK=YourWifiPassword

# =========================================================================
# tailscale (reachability) — required
# =========================================================================
#  >>> TAILSCALE AUTH KEY GOES HERE <<<
# Mint one at: https://login.tailscale.com/admin/settings/keys
# Recommended flags: reusable + preauthorized + ephemeral=false.

TAILSCALE_AUTHKEY=tskey-auth-REPLACEME

# Optional:
# TAILSCALE_HOSTNAME=$HOSTNAME       # default: matches HOSTNAME above
# TAILSCALE_FLAGS=--ssh              # default: enables Tailscale SSH

# =========================================================================
# mqtt-telemetry (health publishing) — required
# =========================================================================

# Broker address. Use your Mac's tailnet name for "works from any wifi"
# (the whole point of the tailnet thing). LAN IP works too but the Pi
# loses the broker if either device roams.
#
# Find your Mac's tailnet name with:  tailscale status | head -1
MQTT_BROKER=your-mac.tailnet-name.ts.net:1883

# Topic prefix. Messages publish under pi/<MQTT_ROLE>/<hostname>/...
MQTT_ROLE=home

# Optional: PEM CA cert for TLS. Empty = plaintext (fine on tailnet).
# MQTT_CERT_PATH=
